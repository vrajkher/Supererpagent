# /etc/raj/server.env  (chmod 600, owner raj)
RAJ_DATA_DIR=/var/lib/raj/server
DEEPSEEK_API_KEY=            # empty = deterministic planner only (no model)
RAJ_AGENT_RUNTIME=auto       # auto | dsh (DeepSeek Harness, needs .[agent]) | direct | rules
RAJ_MODEL=deepseek-flash     # a model id of the Harness deepseek-official adapter (deepseek-flash, deepseek-v4-pro)
# DEEPSEEK_BASE_URL=          # only for a gateway; default is DeepSeek's official Messages endpoint
RAJ_SSH_HOST=raj.example.in   # public name clients connect to
RAJ_SSH_PORT=22
RAJ_SSH_USER=rajtunnel
RAJ_SSH_KNOWN_HOSTS=raj.example.in ssh-ed25519 AAAA...   # output of: ssh-keyscan -t ed25519 raj.example.in
RAJ_TUNNEL_PORT_BASE=20000
RAJ_SSH_KILL_CMD=sudo /opt/raj/infra/ssh/raj-kill-tunnel {port}
